OPENAI_API_KEY=your_key_here

# Optional: a Responses-compatible model with Structured Outputs support.
OPENAI_MODEL=gpt-5.6-luna

# Optional: a scheduling link (Cal.com, Calendly, ...). When set, "Book a call" appears
# in the header, the contact section, the chat's welcome links, and the chat's link allowlist.
NEXT_PUBLIC_BOOKING_URL=

# Chat abuse protection. Defaults shown. Limits are per visitor (hashed IP) unless noted.
CHAT_RATE_LIMIT_PER_MINUTE=8
CHAT_RATE_LIMIT_PER_DAY=60
# Site-wide requests per day across all visitors.
CHAT_DAILY_BUDGET=1500

# Optional but recommended in production: a shared counter (Upstash Redis REST) so the limits
# hold across serverless instances. Without it each instance counts on its own.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
